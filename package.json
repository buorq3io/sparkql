{
  "name": "sparkql",
  "version": "0.2.2",
  "description": "A query builder for SPARQL.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf ./dist/",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose -f test/integration/compose.yaml up -d",
    "db:down": "docker compose -f test/integration/compose.yaml down -v",
    "test:types": "tsc -p test/types",
    "test:exports": "vitest run test/exports.spec.ts",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "semantic-release": "semantic-release",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buorq3io/sparkql.git"
  },
  "bugs": {
    "url": "https://github.com/buorq3io/sparkql/issues"
  },
  "homepage": "https://github.com/buorq3io/sparkql#readme",
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "license": "MIT",
  "author": {
    "name": "Burak Mehmet Ekmekçi",
    "email": "burakmehmetekmekci@gmail.com",
    "url": "https://github.com/buorq3io"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "sparql",
    "rdf",
    "query",
    "builder",
    "query builder"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./arq": {
      "import": {
        "types": "./dist/arq.d.mts",
        "default": "./dist/arq.mjs"
      },
      "require": {
        "types": "./dist/arq.d.cts",
        "default": "./dist/arq.cjs"
      }
    },
    "./stardog": {
      "import": {
        "types": "./dist/stardog.d.mts",
        "default": "./dist/stardog.mjs"
      },
      "require": {
        "types": "./dist/stardog.d.cts",
        "default": "./dist/stardog.cjs"
      }
    },
    "./neptune": {
      "import": {
        "types": "./dist/neptune.d.mts",
        "default": "./dist/neptune.mjs"
      },
      "require": {
        "types": "./dist/neptune.d.cts",
        "default": "./dist/neptune.cjs"
      }
    },
    "./graphdb": {
      "import": {
        "types": "./dist/graphdb.d.mts",
        "default": "./dist/graphdb.mjs"
      },
      "require": {
        "types": "./dist/graphdb.d.cts",
        "default": "./dist/graphdb.cjs"
      }
    },
    "./virtuoso": {
      "import": {
        "types": "./dist/virtuoso.d.mts",
        "default": "./dist/virtuoso.mjs"
      },
      "require": {
        "types": "./dist/virtuoso.d.cts",
        "default": "./dist/virtuoso.cjs"
      }
    },
    "./oxigraph": {
      "import": {
        "types": "./dist/oxigraph.d.mts",
        "default": "./dist/oxigraph.mjs"
      },
      "require": {
        "types": "./dist/oxigraph.d.cts",
        "default": "./dist/oxigraph.cjs"
      }
    },
    "./rdf4j": {
      "import": {
        "types": "./dist/rdf4j.d.mts",
        "default": "./dist/rdf4j.mjs"
      },
      "require": {
        "types": "./dist/rdf4j.d.cts",
        "default": "./dist/rdf4j.cjs"
      }
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.6",
    "@traqula/parser-sparql-1-1": "^1.4.0",
    "@types/node": "^20.19.43",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.6.1",
    "json-diff-ts": "^4.10.4",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@traqula/core": "^1.3.0",
    "@traqula/generator-sparql-1-1": "^1.4.0",
    "@traqula/rules-sparql-1-1": "^1.4.0",
    "@types/sparql-http-client": "^3.1.0",
    "rdf-data-factory": "^2.1.0",
    "sparql-http-client": "^3.1.0"
  }
}
