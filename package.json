{
  "name": "sparkql",
  "version": "0.2.2",
  "description": "A query builder for SPARQL.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf ./dist/",
    "test": "vitest",
    "semantic-release": "semantic-release",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buorq3io/sparkql.git"
  },
  "bugs": {
    "url": "https://github.com/buorq3io/sparkql/issues"
  },
  "homepage": "https://github.com/buorq3io/sparkql#readme",
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "license": "MIT",
  "author": {
    "name": "Burak Mehmet Ekmekçi",
    "email": "burakmehmetekmekci@gmail.com",
    "url": "https://github.com/buorq3io"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "sparql",
    "rdf",
    "query",
    "builder",
    "query builder"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./arq": {
      "import": {
        "types": "./dist/arq.d.mts",
        "default": "./dist/arq.mjs"
      },
      "require": {
        "types": "./dist/arq.d.cts",
        "default": "./dist/arq.cjs"
      }
    },
    "./stardog": {
      "import": {
        "types": "./dist/stardog.d.mts",
        "default": "./dist/stardog.mjs"
      },
      "require": {
        "types": "./dist/stardog.d.cts",
        "default": "./dist/stardog.cjs"
      }
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@traqula/parser-sparql-1-1": "^1.0.7",
    "@types/node": "^20.19.43",
    "@types/sparql-http-client": "^3.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^16.5.0",
    "json-diff-ts": "^4.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@traqula/core": "^1.1.0",
    "@traqula/generator-sparql-1-1": "^1.0.7",
    "@traqula/rules-sparql-1-1": "^1.0.7",
    "rdf-data-factory": "^2.0.2",
    "sparql-http-client": "^3.0.1"
  }
}
