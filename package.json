{
  "name": "sparql-query",
  "version": "0.1.0",
  "description": "A query builder for SPARQL.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf ./dist/",
    "test": "vitest",
    "semantic-release": "semantic-release",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "license": "MIT",
  "author": {
    "name": "Burak Mehmet Ekmekçi",
    "email": "buorq3io@users.noreply.github.com",
    "url": "https://github.com/buorq3io"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "sparql",
    "rdf",
    "query",
    "builder",
    "query builder"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/sparql-http-client": "^3.0.5",
    "@types/sparqljs": "^3.1.12",
    "@vitest/coverage-v8": "^3.2.4",
    "conventional-changelog-conventionalcommits": "^5.0.0",
    "dotenv": "^16.5.0",
    "json-diff-ts": "^4.3.0",
    "lint-staged": "^13.2.1",
    "prettier": "^2.2.1",
    "semantic-release": "^21.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "rdf-data-factory": "^2.0.2",
    "sparql-http-client": "^3.0.1",
    "sparqljs": "^3.7.3"
  }
}
